{
  "name": "galactic-adventure",
  "version": "1.0.0",
  "type": "commonjs",
  "packageManager": "pnpm@10.30.0",
  "dependencies": {
    "@sap/cds": "^10",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "@eslint/js": "^10.0.1",
    "@sap/cds-dk": "^10.1.2",
    "@sap/eslint-plugin-cds": "^4.2.5",
    "@types/node": "^24.13.6",
    "cds-plugin-ui5": "^0.17.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^1.6.1"
  },
  "scripts": {
    "start": "pnpm run typer && cds serve",
    "watch": "cds watch",
    "build": "cds build",
    "typer": "cds-typer \"*\" --outputDirectory @cds-models",
    "typecheck": "pnpm run typer && tsc --noEmit",
    "test": "pnpm run typer && vitest run",
    "lint": "pnpm run lint:cds && pnpm run lint:ts",
    "lint:cds": "cds lint",
    "lint:ts": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test",
    "prepare": "husky",
    "watch-spacefarers": "cds watch --open galactic.spacefarers/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.cds": [
      "cds lint"
    ],
    "*.{json,md,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "private": true,
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "alice",
              "roles": [],
              "attr": {
                "planet": "X"
              }
            },
            "bob": {
              "password": "bob",
              "roles": [],
              "attr": {
                "planet": "Y"
              }
            },
            "admin": {
              "password": "admin",
              "roles": [
                "admin"
              ],
              "attr": {
                "planet": "X"
              }
            },
            "carol": false,
            "dave": false,
            "erin": false,
            "fred": false,
            "me": false,
            "yves": false,
            "*": false
          }
        }
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "sapux": [
    "app/spacefarers"
  ]
}
